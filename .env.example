# GitHub API Token (Optional)
# Authenticated requests increase rate limits from 60 to 5,000 requests per hour.
# No scopes/permissions are required for public repository reading.
GITHUB_TOKEN=

# Optional LLM Enhancement (Optional)
# If provided, an LLM provider can be used to generate expanded issue summaries and checklists.
# Supported providers: OPENAI, GEMINI
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Application Settings
DEBUG_MODE=false
CACHE_TTL_SECONDS=3600
